<#
    Script:  1_CREATE_USERS.ps1
    Purpose: Bulk-creates Active Directory user accounts from a names.txt file
             and places them in a "_USERS" organizational unit.

    This is the PowerShell script I used on the domain controller VM to create
    1k+ users in Active Directory for my Basic Home Lab project.

    Original script by Josh Madakor, from his Active Directory home lab tutorial:
    https://www.youtube.com/watch?v=MHsI8hJmggI https://github.com/joshmadakor1/AD_PS/blob/master/Generate-Names-Create-Users.ps1

    Environment: Windows Server 2025, run in PowerShell ISE as a domain admin
#>

# ----- Edit these Variables for your own Use Case ----- #
$PASSWORD_FOR_USERS   = "Password1"
$USER_FIRST_LAST_LIST = Get-Content .\names.txt
# ------------------------------------------------------ #

$password = ConvertTo-SecureString $PASSWORD_FOR_USERS -AsPlainText -Force
New-ADOrganizationalUnit -Name _USERS -ProtectedFromAccidentalDeletion $false

foreach ($n in $USER_FIRST_LAST_LIST) {
    $first = $n.Split(" ")[0].ToLower()
    $last = $n.Split(" ")[1].ToLower()
    $username = "$($first.Substring(0,1))$($last)".ToLower()
    Write-Host "Creating user: $($username)" -BackgroundColor Black -ForegroundColor Cyan
    
    New-AdUser -AccountPassword $password `
               -GivenName $first `
               -Surname $last `
               -DisplayName $username `
               -Name $username `
               -EmployeeID $username `
               -PasswordNeverExpires $true `
               -Path "ou=_USERS,$(([ADSI]`"").distinguishedName)" `
               -Enabled $true
}
